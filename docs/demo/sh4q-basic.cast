[0.287, "o", "\u001b[1;34musage: \u001b[0m\u001b[1;35msh4q results\u001b[0m [\u001b[32m-h\u001b[0m] [\u001b[36m--database \u001b[33mDATABASE\u001b[0m] [\u001b[36m--type \u001b[33m{domain,ip,url,technology}\u001b[0m] [\u001b[36m--limit \u001b[33mLIMIT\u001b[0m] [\u001b[36m--failures\u001b[0m] [\u001b[36m--target \u001b[33mTARGET\u001b[0m] [\u001b[36m--source \u001b[33mSOURCE\u001b[0m] [\u001b[36m--category \u001b[33mCATEGORY\u001b[0m]\r\n                    [\u001b[36m--status \u001b[33mSTATUS\u001b[0m] [\u001b[36m--details\u001b[0m] [\u001b[36m--scan \u001b[33mSCAN\u001b[0m | \u001b[36m--latest\u001b[0m]\r\n\r\n\u001b[1;34moptions:\u001b[0m\r\n  \u001b[1;32m-h\u001b[0m, \u001b[1;36m--help\u001b[0m            show this help message and exit\r\n  \u001b[1;36m--database\u001b[0m \u001b[1;33mDATABASE\u001b[0m\r\n  \u001b[1;36m--type\u001b[0m \u001b[1;33m{domain,ip,url,technology}\u001b[0m\r\n  \u001b[1;36m--limit\u001b[0m \u001b[1;33mLIMIT\u001b[0m\r\n  \u001b[1;36m--failures\u001b[0m            Show recorded errors and provider failures\r\n  \u001b[1;36m--target\u001b[0m \u001b[1;33mTARGET\u001b[0m       Filter assets or failures by root target\r\n  \u001b[1;36m--source\u001b[0m \u001b[1;33mSOURCE\u001b[0m       Filter results by source plugin\r\n  \u001b[1;36m--category\u001b[0m \u001b[1;33mCATEGORY\u001b[0m   Filter technology observations by category\r\n  \u001b[1;36m--status\u001b[0m \u001b[1;33mSTATUS\u001b[0m       Filter technology observations by HTTP status\r\n  \u001b[1;36m--details\u001b[0m             Show endpoint-level technology observations\r\n  \u001b[1;36m--scan\u001b[0m \u001b[1;33mSCAN\u001b[0m           Show assets observed in one scan run\r\n  \u001b[1;36m--latest\u001b[0m              Show the latest recorded scan\r\n"]
