[0.653, "o", "\u001b[1;34musage: \u001b[0m\u001b[1;35msh4q\u001b[0m [\u001b[32m-h\u001b[0m] [\u001b[36m--version\u001b[0m] \u001b[32m{scan,events,results,scans,show,export,diff} ...\u001b[0m\r\n\r\nSh4q (*_*)/ - policy-controlled reconnaissance with evidence and scope checks.\r\n\r\n\u001b[1;34mpositional arguments:\u001b[0m\r\n  \u001b[1;32m{scan,events,results,scans,show,export,diff}\u001b[0m\r\n    \u001b[1;32mscan\u001b[0m                Scan a target\r\n    \u001b[1;32mevents\u001b[0m              Inspect durable event state\r\n    \u001b[1;32mresults\u001b[0m             View stored assets without writing SQL\r\n    \u001b[1;32mscans\u001b[0m               List recorded scan runs\r\n    \u001b[1;32mshow\u001b[0m                Show a persisted overview of one scan\r\n    \u001b[1;32mexport\u001b[0m              Export one scan to JSON or CSV\r\n    \u001b[1;32mdiff\u001b[0m                Compare scan-owned assets between two scans\r\n\r\n\u001b[1;34moptions:\u001b[0m\r\n  \u001b[1;32m-h\u001b[0m, \u001b[1;36m--help\u001b[0m            show this help message and exit\r\n  \u001b[1;36m--version\u001b[0m             show program's version number and exit\r\n"]
